{
  "name": "browsergba",
  "version": "0.1.0",
  "private": true,
  "description": "BrowserGBA — a local-first, GBA-only browser emulator and personal game library.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "sync:core": "node scripts/sync-core.mjs",
    "predev": "npm run sync:core",
    "prebuild": "npm run sync:core",
    "prepreview": "npm run sync:core",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "node tests/browser/run-smoke.mjs",
    "check": "npm run typecheck && npm run test",
    "rom:fixture": "node tools/make-test-rom.mjs"
  },
  "dependencies": {
    "@thenick775/mgba-wasm": "^2.5.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "fake-indexeddb": "^6.0.0",
    "happy-dom": "^21.0.1",
    "puppeteer-core": "^25.13.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
