node_modules/
dist/
dist-ssr/
coverage/

# Vendored emulator core artifacts are generated by scripts/sync-core.mjs
# (copied verbatim from node_modules/@thenick775/mgba-wasm) so we never
# hand-edit third-party binaries and keep the repository small.
public/mgba/

# Test fixtures generated by tools/make-test-rom.mjs (original, MIT-licensed,
# but reproducible, so not committed).
fixtures/*.gba

# Local scratch / device dumps. Never commit ROMs, BIOS files or saves.
*.local
.local/
tmp/
*.log
.DS_Store
.vite/
.env
.env.*
!.env.example
tests/browser/artifacts/
